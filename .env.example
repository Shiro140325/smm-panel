# Neon connection string (direct or pooled both work)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

BASE_URL=https://api.yourdomain.com
FRONTEND_ORIGIN=https://yourdomain.com
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true

PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
PAYMONGO_METHODS=gcash,paymaya

# Provider API keys (names must match providers.api_key_env)
SMMGEN_API_KEY=
SMMFOLLOWOM_API_KEY=

USD_TO_PHP=58
SYNC_INTERVAL_SECONDS=180
SYNC_ENABLED=true
