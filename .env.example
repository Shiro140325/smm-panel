# Supabase pooler in SESSION mode (port 5432). Not transaction mode (6543): it doesn't
# support the prepared statements SQLAlchemy's asyncpg driver uses. The smm_app role's
# search_path is the "smm" schema, so table names stay unqualified.
DATABASE_URL=postgresql://smm_app.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

BASE_URL=https://api.yourdomain.com
FRONTEND_ORIGIN=https://yourdomain.com
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true

PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
PAYMONGO_METHODS=gcash,paymaya

# Provider API keys (names must match providers.api_key_env)
SMMGEN_API_KEY=
SMMFOLLOWOM_API_KEY=

USD_TO_PHP=58
SYNC_INTERVAL_SECONDS=180
SYNC_ENABLED=true
